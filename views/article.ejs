<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= article.title %> - Abdullah Zahra</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">

  <!-- Highlight.js Theme (Atom One Dark) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">

  <!-- Make images and videos responsive -->
  <style>
    .markdown-body img {
      max-width: 100%;
      border-radius: 8px;
      height: auto;
    }

    .markdown-body iframe {
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 8px;
    }
  </style>
</head>

<body class="bg-light">
  <!-- Navbar remains standard LTR -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-5">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">Abdullah Zahra</a>
    </div>
  </nav>

  <div class="container my-5">
    <div class="row">
      <!-- Article Container (Adapts based on language) -->
      <div class="container py-5" style="max-width: 800px;" <%- article.language === 'ar' ? 'dir="rtl" style="font-family: \'Cairo\', sans-serif;"' : '' %>>

        <a href="/" class="text-decoration-none text-muted mb-4 d-inline-block">&larr; Back to Home</a>

        <header class="mb-5">
          <div class="mb-3">
            <% article.tags.forEach(tag => { %>
            <span class="badge bg-dark me-1"><%= tag %></span>
            <% }) %>
          </div>
          <h1 class="fw-bold mb-3"><%= article.title %></h1>
          <p class="text-muted border-bottom pb-3"><%= article.date %></p>
        </header>

        <section class="markdown-body" style="font-size: 1.1rem; line-height: 1.8;">
          <%- htmlContent %>
        </section>
      </div>
    </div>
  </div>

  <!-- Highlight.js Engine -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
  <script>
    // Initialize syntax highlighting on all <pre><code> blocks
    document.addEventListener('DOMContentLoaded', (event) => {
      document.querySelectorAll('pre code').forEach((el) => {
        hljs.highlightElement(el);
      });
    });
  </script>
</body>

</html>