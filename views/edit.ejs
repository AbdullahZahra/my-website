<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Article</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="container mt-5">

  <h2>Edit Article</h2>
  <a href="/admin" class="text-decoration-none mb-4 d-inline-block">&larr; Back to Dashboard</a>

  <!-- The form posts to the update route with the specific article ID -->
  <form action="/admin/edit/<%= article._id %>" method="POST">
    <div class="mb-3">
      <label class="form-label">Title</label>
      <input type="text" name="title" class="form-control" value="<%= article.title %>" required>
    </div>

    <div class="mb-3">
      <label class="form-label">Language</label>
      <select name="language" class="form-select">
        <option value="en" <%= article.language === 'en' ? 'selected' : '' %>>English (LTR)</option>
        <option value="ar" <%= article.language === 'ar' ? 'selected' : '' %>>Arabic (RTL)</option>
      </select>
    </div>

    <div class="mb-3">
      <label class="form-label">Content (Markdown)</label>
      <textarea name="content" class="form-control" rows="15" required><%= article.content %></textarea>
    </div>

    <button type="submit" class="btn btn-success">Update Article</button>
  </form>

</body>

</html>