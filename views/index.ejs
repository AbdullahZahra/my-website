<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Website - Abdullah Zahra</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
</head>
<body class="bg-light">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">Abdullah Zahra</a>
        </div>
    </nav>

    <!-- Header -->
    <header class="bg-primary text-white text-center py-5 mb-4">
        <div class="container">
            <h1 class="fw-light">Abdullah Zahra's Blog</h1>
        </div>
    </header>

    <!-- Main Content -->
    <div class="container">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <h2 class="mb-4">Latest Articles</h2>
                
                <% articles.forEach(article => { %>
                    <!-- Dynamically set text direction and font based on language -->
                    <div class="card mb-4 shadow-sm border-0" 
                         <%- article.language === 'ar' ? 'dir="rtl" style="font-family: \'Cairo\', sans-serif;"' : '' %>>
                        
                        <div class="card-body">
                            <h3 class="card-title"><%= article.title %></h3>
                            <a href="/article/<%= article.id %>" class="btn btn-outline-primary mt-2" 
                               <%- article.language === 'ar' ? 'dir="rtl"' : '' %>>
                                <%= article.language === 'ar' ? 'اقرأ المقال ←' : 'Read Article →' %>
                            </a>
                        </div>
                    </div>
                <% }) %>
                
            </div>
        </div>
    </div>
</body>
</html>