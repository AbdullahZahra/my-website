<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Abdullah Zahra | Blog</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
  <style>
    .card {
      transition: transform 0.2s ease-in-out;
    }

    .card:hover {
      transform: translateY(-5px);
    }
  </style>
</head>

<body class="bg-light">

  <!-- Navigation / Header -->
  <div class="container py-5" style="max-width: 1000px;">
    <header class="text-center mb-5">
      <h1 class="display-4 fw-bold">Abdullah Zahra</h1>
      <p class="lead text-muted">Thoughts on software engineering, digital marketing, and tech.</p>
    </header>

    <!-- Articles Grid -->
    <div class="row g-4">
      <% if (articles.length === 0) { %>
      <div class="col-12 text-center text-muted mt-5">
        <p>No articles published yet.</p>
      </div>
      <% } else { %>
      <% articles.forEach(article => { %>
      <div class="col-md-6">
        <!-- Card adapts dynamically to Arabic or English -->
        <div class="card h-100 border-0 shadow-sm" <%- article.language === 'ar' ? 'dir="rtl" style="font-family: \'Cairo\', sans-serif;"' : '' %>>

          <div class="card-body d-flex flex-column p-4">
            <!-- Tags -->
            <div class="mb-3">
              <% article.tags.forEach(tag => { %>
              <span class="badge bg-dark me-1"><%= tag %></span>
              <% }) %>
            </div>

            <!-- Title & Date -->
            <h4 class="card-title fw-bold mb-2"><%= article.title %></h4>
            <p class="text-muted small mb-4"><%= article.date || 'Recently Published' %></p>

            <!-- Read Button (Forced LTR so the button aligns nicely even on Arabic cards) -->
            <div class="mt-auto" <%- article.language === 'ar' ? 'dir="ltr"' : '' %>>
              <a href="/article/<%= article._id %>" class="btn btn-outline-primary btn-sm w-100">Read Article</a>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
      <% } %>
    </div>
  </div>

</body>

</html>